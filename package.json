{
  "name": "kotlin-springboot-exposed-template-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint:js": "eslint --config config/ui/eslint.config.mjs --max-warnings=0 src/main/resources/static",
    "lint:css": "stylelint --config config/ui/stylelint.config.mjs --max-warnings=0 \"src/main/resources/static/**/*.css\"",
    "format:check": "prettier --config config/ui/prettier.json --check \"src/main/resources/static/**/*.{js,css}\" \"config/ui/*.mjs\" \"src/test/ui/*.mjs\"",
    "format": "prettier --config config/ui/prettier.json --write \"src/main/resources/static/**/*.{js,css}\" \"config/ui/*.mjs\" \"src/test/ui/*.mjs\"",
    "test": "node --test \"src/test/ui/*.test.mjs\"",
    "lint:html": "html-validate --config config/ui/htmlvalidate.json \"build/rendered-ui/**/*.html\"",
    "check": "pnpm lint:js && pnpm lint:css && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "html-validate": "11.17.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  }
}
